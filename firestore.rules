rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────
    // Helpers
    // ─────────────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function fieldDelta(field) {
      // delta = nouvelle valeur - ancienne valeur, en number
      return (request.resource.data[field] - resource.data[field]);
    }
    function affectedKeysHasOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ============================================
    // PROFILS UTILISATEURS — durcis (v2.1.35)
    // - Lecture : owner OU profil MEDECIN (publication des médecins
    //   nécessaire pour le choix patient ; les profils patients restent
    //   privés). C'est un compromis : email/téléphone d'un médecin sont
    //   considérés professionnels (cabinet) donc lisibles.
    // - Update : owner full, OU autres users SEULEMENT pour les
    //   compteurs d'agrégation avec validation des deltas (anti-fraude).
    // ============================================
    match /users/{userId} {
      allow read: if isSignedIn() && (
        request.auth.uid == userId
        || resource.data.role == 'MEDECIN'
      );
      allow create: if isOwner(userId);
      allow delete: if isOwner(userId);
      allow update: if isSignedIn() && (
        request.auth.uid == userId
        || (
          // Mise à jour des compteurs uniquement, par n'importe quel user
          // authentifié, avec validation stricte des deltas.
          affectedKeysHasOnly(['ratingSum', 'reviewCount', 'consultationCount'])
          && (
            !('ratingSum' in request.resource.data.diff(resource.data).affectedKeys())
            || (fieldDelta('ratingSum') >= -5 && fieldDelta('ratingSum') <= 5)
          )
          && (
            !('reviewCount' in request.resource.data.diff(resource.data).affectedKeys())
            || fieldDelta('reviewCount') == 1
            || fieldDelta('reviewCount') == 0
            || fieldDelta('reviewCount') == -1
          )
          && (
            !('consultationCount' in request.resource.data.diff(resource.data).affectedKeys())
            || fieldDelta('consultationCount') == 1
          )
        )
      );

      // Sous-collection repas — strictement privée
      match /repas/{repasId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    // ============================================
    // AVIS MEDECINS
    // Inchangé : reviewId déterministe = anti-double-review.
    // ============================================
    match /doctor_reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                             && request.auth.uid == request.resource.data.patientUid
                             && reviewId == request.resource.data.doctorUid + '_' + request.auth.uid
                             && request.resource.data.rating is int
                             && request.resource.data.rating >= 1
                             && request.resource.data.rating <= 5;
      allow delete: if isSignedIn() && resource.data.patientUid == request.auth.uid;
    }

    // ============================================
    // DONNEES MEDICALES (patient → owner)
    // ============================================
    match /patients/{patientId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /glucose/{docId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /medicaments/{medId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /rendezvous/{rdvId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /journal/{entryId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /repas/{repasId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /activite/{docId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    match /steps/{docId} {
      allow read, update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // ============================================
    // CONVERSATIONS (patient↔médecin)
    // Inchangé : participants uniquement.
    // ============================================
    match /conversations/{conversationId} {
      allow read: if isSignedIn()
                  && (resource.data.patientId == request.auth.uid
                      || resource.data.medecinId == request.auth.uid);
      allow create: if isSignedIn()
                    && (request.resource.data.patientId == request.auth.uid
                        || request.resource.data.medecinId == request.auth.uid);
      allow update: if isSignedIn()
                    && (resource.data.patientId == request.auth.uid
                        || resource.data.medecinId == request.auth.uid);

      match /messages/{messageId} {
        allow read, create: if isSignedIn()
          && (get(/databases/$(database)/documents/conversations/$(conversationId)).data.patientId == request.auth.uid
              || get(/databases/$(database)/documents/conversations/$(conversationId)).data.medecinId == request.auth.uid);
      }
    }

    // ============================================
    // HISTORIQUE CHATBOT ROLLY
    // ============================================
    match /rolly_history/{userId} {
      allow read, write: if isOwner(userId);
      match /messages/{messageId} {
        allow read, write: if isOwner(userId);
      }
      match /conversations/{convId} {
        allow read, write: if isOwner(userId);
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    // ============================================
    // VALIDATIONS ROLLY — durcis (v2.1.35)
    // Plus de create libre : il faut être patient OU médecin concerné.
    // ============================================
    match /validations/{validationId} {
      allow read: if isSignedIn()
                  && (resource.data.patientUid == request.auth.uid
                      || resource.data.medecinUid == request.auth.uid);
      allow create: if isSignedIn()
                    && (request.resource.data.patientUid == request.auth.uid
                        || request.resource.data.medecinUid == request.auth.uid);
      allow update: if isSignedIn()
                    && (resource.data.patientUid == request.auth.uid
                        || resource.data.medecinUid == request.auth.uid);
    }

    // ============================================
    // CONSENTEMENTS / DATA SHARING — durcis (v2.1.35)
    // Plus de create libre : il faut être l'un des deux participants.
    // ============================================
    match /consents/{consentId} {
      allow read: if isSignedIn()
                  && (resource.data.patientUid == request.auth.uid
                      || resource.data.medecinUid == request.auth.uid);
      allow create: if isSignedIn()
                    && (request.resource.data.patientUid == request.auth.uid
                        || request.resource.data.medecinUid == request.auth.uid);
      allow update: if isSignedIn()
                    && (resource.data.patientUid == request.auth.uid
                        || resource.data.medecinUid == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.patientUid == request.auth.uid;
    }
    match /data_sharing/{docId} {
      allow read: if isSignedIn()
                  && (resource.data.patientUid == request.auth.uid
                      || resource.data.medecinUid == request.auth.uid);
      allow create: if isSignedIn()
                    && (request.resource.data.patientUid == request.auth.uid
                        || request.resource.data.medecinUid == request.auth.uid);
      allow update: if isSignedIn()
                    && (resource.data.patientUid == request.auth.uid
                        || resource.data.medecinUid == request.auth.uid);
      allow delete: if isSignedIn() && resource.data.patientUid == request.auth.uid;
    }

    // ============================================
    // BACKUPS — durcis (v2.1.35)
    // Limite la taille des documents pour éviter l'épuisement du quota Spark.
    // ============================================
    match /backups/{userId}/{document=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
                   && request.resource.size() < 100000;
    }

    // ============================================
    // APPELS VoIP — durcis (v2.1.35)
    // Le créateur DOIT être l'un des deux participants déclarés.
    // ============================================
    match /calls/{callId} {
      allow read: if isSignedIn()
                  && (resource.data.callerUid == request.auth.uid
                      || resource.data.calleeUid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.callerUid == request.auth.uid
                    && request.resource.data.calleeUid is string
                    && request.resource.data.calleeUid.size() > 0
                    && request.resource.data.calleeUid != request.auth.uid;
      allow update: if isSignedIn()
                    && (resource.data.callerUid == request.auth.uid
                        || resource.data.calleeUid == request.auth.uid);

      match /iceCandidates/{iceId} {
        allow read, write: if isSignedIn()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerUid == request.auth.uid
              || get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid == request.auth.uid);
      }
    }

    // ============================================
    // QUOTA IA
    // ============================================
    match /quota/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ============================================
    // CONFIG APP
    // ============================================
    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ============================================
    // COMMUNAUTE — durcis (v2.1.35)
    // Validation longueur + type du content pour bloquer le spam.
    // ============================================
    match /community_messages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.contenu is string
                    && request.resource.data.contenu.size() > 0
                    && request.resource.data.contenu.size() <= 1000;
      allow update, delete: if isSignedIn()
                            && resource.data.userId == request.auth.uid;
    }

    // ============================================
    // FCM TOKENS — durcis (v2.1.35)
    // Lecture restreinte au propriétaire (les serveurs Vercel utilisent
    // l'Admin SDK qui bypass les rules).
    // ============================================
    match /fcm_tokens/{docId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid);
    }

    // ============================================
    // EMAIL OTP (écrit uniquement par les endpoints Vercel)
    // ============================================
    match /email_otp/{uid} {
      allow read, write: if false;
    }

    // ============================================
    // RAPPORTS — durcis (v2.1.35)
    // recipientUid validé (string non vide).
    // ============================================
    match /reports/{ownerUid}/items/{reportId} {
      allow read: if isSignedIn()
                  && (request.auth.uid == ownerUid
                      || resource.data.recipientUid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.auth.uid == ownerUid
                    && request.resource.data.ownerUid == ownerUid
                    && request.resource.data.recipientUid is string;
      allow update, delete: if isSignedIn() && request.auth.uid == ownerUid;
    }

    // ============================================
    // RATE LIMITING (utilisé par les endpoints Vercel)
    // Documents écrits par Admin SDK seulement.
    // ============================================
    match /rate_limits/{uid} {
      allow read, write: if false;
    }
  }
}
