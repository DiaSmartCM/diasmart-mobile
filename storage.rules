rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Photos de profil — seul l'utilisateur peut upload sa photo
    match /profile_photos/{userId}.jpg {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Modeles IA (Gemma .task) — lecture publique pour tous les utilisateurs connectes
    // Ecriture interdite cote client (upload via console Firebase / gcloud CLI uniquement)
    match /models/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Rapports PDF (patient → medecin, medecin → patient).
    // Proprietaire seul peut uploader. Lecture autorisee a tout utilisateur
    // authentifie : le destinataire recoit l'URL via la messagerie.
    match /reports/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType == 'application/pdf';
    }

    // Fallback — bloquer tout le reste
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
