rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════════
    //  HELPERS
    // ════════════════════════════════════════════════════════════════
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isResourceOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }
    function isCreatingAsSelf() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    // v2.1.43 : verifie qu'un consent actif existe entre le patient (proprietaire
    // de la donnee) et le medecin authentifie. Doc ID : {patientUid}_{medecinUid}.
    // 1 read supplementaire par requete, accepte pour la securite.
    function isLinkedDoctorOf(patientUid) {
      let docId = patientUid + "_" + request.auth.uid;
      return isSignedIn() &&
             exists(/databases/$(database)/documents/data_sharing/$(docId)) &&
             get(/databases/$(database)/documents/data_sharing/$(docId)).data.isActive == true;
    }
    // v2.1.48 : verifie qu'un lien familial actif existe entre l'owner
    // (proprietaire des donnees) et l'aidant authentifie. Doc ID :
    // {ownerUid}_{aidantUid}. L'aidant peut LIRE les donnees medicales,
    // jamais les modifier.
    function isFamilyAidantOf(ownerUid) {
      let docId = ownerUid + "_" + request.auth.uid;
      return isSignedIn() &&
             exists(/databases/$(database)/documents/family_links/$(docId)) &&
             get(/databases/$(database)/documents/family_links/$(docId)).data.isActive == true;
    }
    // Helper combine : owner OU medecin lie OU aidant familial.
    function canReadPatientData(ownerUid) {
      return isOwner(ownerUid) || isLinkedDoctorOf(ownerUid) || isFamilyAidantOf(ownerUid);
    }
    // Espace etablissement (B2B2C) : le compte connecte est-il soignant
    // (ou administrateur) de l'etablissement ?
    function estMembreEtablissement(etabId) {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/etablissements/$(etabId)/membres/$(request.auth.uid));
    }
    function estAdminEtablissement(etabId) {
      return isSignedIn() &&
             get(/databases/$(database)/documents/etablissements/$(etabId)).data.adminUid == request.auth.uid;
    }
    // Validation des donnees (memes limites que EtablissementRepository).
    function texteOk(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function codeFormat(c) {
      return c is string && c.matches('^[ABCDEFGHJKMNPQRSTUVWXYZ23456789]{8}$');
    }
    function etablissementValide(d) {
      return d.keys().hasOnly(['nom', 'ville', 'adminUid', 'codePatient', 'codeSoignant', 'createdAt']) &&
             texteOk(d.nom, 2, 80) &&
             texteOk(d.ville, 0, 60) &&
             codeFormat(d.codePatient) && codeFormat(d.codeSoignant) &&
             d.createdAt is int;
    }
    // Un code d'invitation actif, du bon type, pour cet etablissement.
    function codeValide(code, etabId, type) {
      let c = /databases/$(database)/documents/codes_invitation/$(code);
      return code is string && exists(c) &&
             get(c).data.etablissementId == etabId &&
             get(c).data.type == type &&
             get(c).data.actif == true;
    }
    // Le patient s'est inscrit lui-meme (avec le code patient) dans un
    // etablissement dont le compte connecte est soignant. Lecture seule.
    function isSoignantEtablissementOf(patientUid) {
      let aff = /databases/$(database)/documents/affiliations/$(patientUid);
      return isSignedIn() && exists(aff) &&
             get(aff).data.role == 'PATIENT' &&
             estMembreEtablissement(get(aff).data.etablissementId) &&
             exists(/databases/$(database)/documents/etablissements/$(get(aff).data.etablissementId)/patients/$(patientUid));
    }

    // ════════════════════════════════════════════════════════════════
    //  PROFILS UTILISATEURS
    //  - lecture : tout authentifie (necessaire pour qu'un patient voie le
    //    profil de son medecin et inversement)
    //  - ecriture : SEULEMENT le proprietaire du compte
    // ════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId);

      match /repas/{repasId} {
        allow read: if isOwner(userId) || isLinkedDoctorOf(userId);
        allow write: if isOwner(userId);
      }
      match /{subcollection=**} {
        allow read: if isOwner(userId) || isLinkedDoctorOf(userId);
        allow write: if isOwner(userId);
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  DONNEES MEDICALES PATIENT (top-level)
    //  Pattern : chaque doc porte un champ `userId` qui identifie le
    //  proprietaire. Seul lui peut ECRIRE. Lui-meme + son medecin lie
    //  peuvent LIRE.
    // ════════════════════════════════════════════════════════════════
    match /glucose/{docId} {
      allow read: if isResourceOwner() || isLinkedDoctorOf(resource.data.userId) || isFamilyAidantOf(resource.data.userId);
      allow create: if isCreatingAsSelf();
      allow update, delete: if isResourceOwner();
    }
    match /repas/{repasId} {
      allow read: if isResourceOwner() || isLinkedDoctorOf(resource.data.userId) || isFamilyAidantOf(resource.data.userId);
      allow create: if isCreatingAsSelf();
      allow update, delete: if isResourceOwner();
    }
    match /medicaments/{medId} {
      allow read: if isResourceOwner() || isLinkedDoctorOf(resource.data.userId) || isFamilyAidantOf(resource.data.userId);
      allow create: if isCreatingAsSelf();
      allow update, delete: if isResourceOwner();
    }
    match /rendezvous/{rdvId} {
      // RDV peuvent etre crees par le patient OU son medecin lie (le medecin
      // valide un RDV). Mais MODIFICATION seulement par le createur.
      allow read: if isResourceOwner() ||
                     (isSignedIn() && resource.data.medecinUid == request.auth.uid) ||
                     isLinkedDoctorOf(resource.data.userId);
      allow create: if isSignedIn();  // patient ou medecin
      allow update: if isResourceOwner() ||
                       (isSignedIn() && resource.data.medecinUid == request.auth.uid);
      allow delete: if isResourceOwner();
    }
    match /journal/{entryId} {
      allow read: if isResourceOwner() || isLinkedDoctorOf(resource.data.userId) || isFamilyAidantOf(resource.data.userId);
      allow create: if isCreatingAsSelf();
      allow update, delete: if isResourceOwner();
    }
    match /hba1c_lectures/{docId} {
      allow read: if isResourceOwner() || isLinkedDoctorOf(resource.data.userId) || isFamilyAidantOf(resource.data.userId);
      allow create: if isCreatingAsSelf();
      allow update, delete: if isResourceOwner();
    }
    match /patients/{patientId} {
      allow read: if isResourceOwner() || isLinkedDoctorOf(resource.data.userId) || isFamilyAidantOf(resource.data.userId);
      allow create: if isCreatingAsSelf();
      allow update, delete: if isResourceOwner();
    }

    // ════════════════════════════════════════════════════════════════
    //  MESSAGERIE PATIENT-MEDECIN
    //  - Lecture : participants (patient + medecin) listes dans le doc
    //  - Ecriture des messages : un participant seulement
    // ════════════════════════════════════════════════════════════════
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
                     resource.data.patientId == request.auth.uid ||
                     resource.data.medecinId == request.auth.uid
                   );
      allow create: if isSignedIn() && (
                       request.resource.data.patientId == request.auth.uid ||
                       request.resource.data.medecinId == request.auth.uid
                     );
      allow update: if isSignedIn() && (
                       resource.data.patientId == request.auth.uid ||
                       resource.data.medecinId == request.auth.uid
                     );
      allow delete: if false;  // pas de suppression

      match /messages/{messageId} {
        // Pour lire les messages, on doit etre dans la conv parente
        function inConversation() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return isSignedIn() && (conv.patientId == request.auth.uid || conv.medecinId == request.auth.uid);
        }
        allow read: if inConversation();
        allow create: if inConversation() &&
                         request.resource.data.envoyeurId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  HISTORIQUE CHATBOT ROLLY
    //  Chaque sous-collection rolly_history/{userId} appartient a son uid.
    // ════════════════════════════════════════════════════════════════
    match /rolly_history/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  VALIDATIONS ROLLY (medecin valide une recommandation IA)
    // ════════════════════════════════════════════════════════════════
    match /validations/{validationId} {
      allow read: if isSignedIn() && (
                     resource.data.medecinUid == request.auth.uid ||
                     resource.data.patientUid == request.auth.uid
                   );
      // v2.1.73 : c'est le PATIENT qui soumet une reponse ROLLY a son medecin
      // (ValidationRepository.createValidation ecrit patientUid = son propre
      // uid). La regle exigeait medecinUid == auth.uid, donc seul le medecin
      // pouvait creer : l'envoi du patient etait toujours refuse.
      // La validation elle-meme (approbation/commentaire) reste reservee au
      // medecin destinataire via `update`.
      allow create: if isSignedIn() &&
                       request.resource.data.patientUid == request.auth.uid &&
                       request.resource.data.medecinUid is string &&
                       request.resource.data.medecinUid.size() > 0;
      allow update: if isSignedIn() && resource.data.medecinUid == request.auth.uid;
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════
    //  CONSENTEMENTS / DATA SHARING
    //  Doc ID : {patientUid}_{medecinUid}
    //  - lecture : les 2 parties impliquees
    //  - creation : par le medecin (demande) ou le patient (auto-link)
    //  - update/delete : par les 2 parties (patient peut revoquer, medecin
    //    peut se desabonner)
    // ════════════════════════════════════════════════════════════════
    match /data_sharing/{docId} {
      function isParty() {
        return isSignedIn() && (
          resource.data.patientUid == request.auth.uid ||
          resource.data.medecinUid == request.auth.uid
        );
      }
      function isPartyOnCreate() {
        return isSignedIn() && (
          request.resource.data.patientUid == request.auth.uid ||
          request.resource.data.medecinUid == request.auth.uid
        );
      }
      allow read: if isParty();
      allow create: if isPartyOnCreate();
      allow update: if isParty();
      allow delete: if isParty();
    }

    // ════════════════════════════════════════════════════════════════
    //  DOSSIER NUMERIQUE PATIENT (tenu par le medecin)
    //  Doc ID : {patientUid}_{medecinUid}, identique au lien data_sharing.
    //  - medecin : lit et ecrit tant que le lien est actif
    //  - patient : lit le dossier et les seules fiches visiblePatient == true,
    //    meme apres la fin du lien (droit d'acces a ses donnees) ; n'ecrit
    //    rien, sauf la creation du dossier vide quand il accepte le lien
    //  - suppression du dossier : jamais (tracabilite)
    // ════════════════════════════════════════════════════════════════
    match /dossiers/{dossierId} {
      function partiesDossier() {
        return dossierId.split('_');
      }
      function estPatientDossier() {
        return isSignedIn() && partiesDossier()[0] == request.auth.uid;
      }
      function estMedecinLieDossier() {
        return isSignedIn() &&
               partiesDossier().size() == 2 &&
               partiesDossier()[1] == request.auth.uid &&
               isLinkedDoctorOf(partiesDossier()[0]);
      }
      function lienActifDossier() {
        return exists(/databases/$(database)/documents/data_sharing/$(dossierId)) &&
               get(/databases/$(database)/documents/data_sharing/$(dossierId)).data.isActive == true;
      }

      // Deux formes de lecture pour le patient :
      // - par identifiant (estPatientDossier) : indispensable pour verifier
      //   qu'un dossier existe avant de le creer. Un document absent n'a pas
      //   de resource.data, qui seul faisait donc refuser la lecture ;
      // - par resource.data : autorise sa requete "whereEqualTo(patientUid, moi)".
      allow read: if estPatientDossier() ||
                     (isSignedIn() && resource != null && resource.data.patientUid == request.auth.uid) ||
                     estMedecinLieDossier();
      allow create: if (estMedecinLieDossier() || (estPatientDossier() && lienActifDossier())) &&
                       request.resource.data.patientUid == partiesDossier()[0] &&
                       request.resource.data.medecinUid == partiesDossier()[1];
      allow update: if estMedecinLieDossier() &&
                       request.resource.data.patientUid == resource.data.patientUid &&
                       request.resource.data.medecinUid == resource.data.medecinUid;
      allow delete: if false;

      match /entrees/{entreeId} {
        allow read: if estMedecinLieDossier() ||
                       (estPatientDossier() && resource.data.visiblePatient == true);
        allow create: if estMedecinLieDossier() &&
                         request.resource.data.auteurUid == request.auth.uid &&
                         request.resource.data.patientUid == partiesDossier()[0] &&
                         request.resource.data.medecinUid == partiesDossier()[1];
        allow update: if estMedecinLieDossier() &&
                         request.resource.data.patientUid == resource.data.patientUid &&
                         request.resource.data.medecinUid == resource.data.medecinUid &&
                         request.resource.data.auteurUid == resource.data.auteurUid;
        allow delete: if estMedecinLieDossier();
      }
    }

    // Ancien collection (compat)
    match /consents/{consentId} {
      allow read, write: if isSignedIn();
    }

    // ════════════════════════════════════════════════════════════════
    //  FAMILY LINKS (v2.1.48 — Mode famille)
    //  Doc ID : {ownerUid}_{aidantUid}
    //  - lecture : les 2 parties (owner + aidant)
    //  - create : owner cree l'invitation (ownerUid == auth.uid)
    //  - update : les 2 parties (accept/reject/revoke/reactivate)
    //  - delete : interdit (on garde la tracabilite)
    // ════════════════════════════════════════════════════════════════
    match /family_links/{docId} {
      function isFamilyParty() {
        return isSignedIn() && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.aidantUid == request.auth.uid
        );
      }
      allow read: if isFamilyParty();
      allow create: if isSignedIn() &&
                       request.resource.data.ownerUid == request.auth.uid;
      allow update: if isFamilyParty();
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════
    //  COMMUNAUTE PATIENTS
    //  Tout user lit. Ecriture : auteur seul.
    // ════════════════════════════════════════════════════════════════
    match /community_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
                               resource.data.userId == request.auth.uid;
    }

    // v2.1.98 : indicateur de frappe dans la Communaute. Un document par
    // utilisateur en train d'ecrire, supprime a l'arret (cf. CommunityRepository).
    match /community_typing/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ════════════════════════════════════════════════════════════════
    //  AVIS PATIENT SUR MEDECIN
    //  Doc ID : {doctorUid}_{patientUid}
    //  - lecture : tout authentifie (les avis sont publics par design)
    //  - creation/maj : par le patient auteur uniquement
    //  - suppression : par le patient auteur ou par le medecin (au cas ou)
    // ════════════════════════════════════════════════════════════════
    match /doctor_reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       request.resource.data.patientUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.patientUid == request.auth.uid;
      allow delete: if isSignedIn() && (
                       resource.data.patientUid == request.auth.uid ||
                       resource.data.doctorUid == request.auth.uid
                     );
    }

    // ════════════════════════════════════════════════════════════════
    //  APPELS VoIP / WebRTC SIGNALING
    // ════════════════════════════════════════════════════════════════
    match /calls/{callId} {
      function isInCall() {
        return isSignedIn() && (
          resource.data.callerUid == request.auth.uid ||
          resource.data.calleeUid == request.auth.uid
        );
      }
      function isInCallOnCreate() {
        return isSignedIn() &&
          request.resource.data.callerUid == request.auth.uid;
      }
      allow read: if isInCall();
      allow create: if isInCallOnCreate();
      allow update: if isInCall();
      allow delete: if isInCall();

      match /{subcollection=**} {
        allow read, write: if isSignedIn();
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  PRESENCE (v2.1.97 — en ligne/hors ligne, heartbeat cote client)
    //  - lecture : tout authentifie (necessaire pour voir le statut de
    //    l'interlocuteur dans la messagerie)
    //  - ecriture : uniquement son propre document
    // ════════════════════════════════════════════════════════════════
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    // ════════════════════════════════════════════════════════════════
    //  FCM TOKENS (private)
    // ════════════════════════════════════════════════════════════════
    match /fcm_tokens/{tokenId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() &&
                       request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ════════════════════════════════════════════════════════════════
    //  RATE LIMITS (lus + ecrits cote serveur Vercel uniquement,
    //  mais on autorise read par owner pour debug)
    // ════════════════════════════════════════════════════════════════
    match /rate_limits/{docId} {
      allow read: if isSignedIn();
      allow write: if false;  // ecriture serveur uniquement (Admin SDK)
    }

    // ════════════════════════════════════════════════════════════════
    //  QUOTA (IA par jour, par user)
    // ════════════════════════════════════════════════════════════════
    match /quota/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ════════════════════════════════════════════════════════════════
    //  CONFIG APP (mise a jour, versioning) — lecture publique
    // ════════════════════════════════════════════════════════════════
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;  // ecriture manuelle via console firebase
    }

    // ════════════════════════════════════════════════════════════════
    //  BACKUPS PATIENT
    // ════════════════════════════════════════════════════════════════
    //  v2.1.72 : le backup cloud ecrit dans des SOUS-collections
    //  (backups/{uid}/metadata/info, backups/{uid}/glucose/...). Un
    //  `match /backups/{userId}` seul ne couvre PAS les sous-collections :
    //  il faut un `{document=**}` explicite, sinon toute sauvegarde /
    //  restauration est refusee. Le medecin lie lit les donnees patient
    //  depuis backups/{uid}/glucose (cf. DataSharingRepository).
    match /backups/{userId} {
      allow read: if isOwner(userId) || isLinkedDoctorOf(userId);
      allow write: if isOwner(userId) && request.resource.size() < 100000;

      match /{document=**} {
        allow read: if isOwner(userId) || isLinkedDoctorOf(userId) || isSoignantEtablissementOf(userId);
        allow write: if isOwner(userId);
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  OBJECTIF DE TENSION PERSONNEL (fixe par le medecin ou un soignant)
    //  Doc ID : {patientUid}. Le patient le lit ; le medecin lie ou un
    //  soignant de son etablissement le fixe, le change ou le retire.
    // ════════════════════════════════════════════════════════════════
    match /objectifs_tension/{patientUid} {
      function peutFixerObjectif() {
        return isLinkedDoctorOf(patientUid) || isSoignantEtablissementOf(patientUid);
      }
      allow read: if isOwner(patientUid) || peutFixerObjectif();
      allow create, update: if peutFixerObjectif() &&
        request.resource.data.keys().hasOnly(['systolique', 'diastolique', 'auteurUid', 'auteurNom', 'majAt']) &&
        request.resource.data.auteurUid == request.auth.uid &&
        request.resource.data.systolique is int && request.resource.data.diastolique is int &&
        request.resource.data.systolique >= 100 && request.resource.data.systolique <= 170 &&
        request.resource.data.diastolique >= 60 && request.resource.data.diastolique <= 110 &&
        request.resource.data.systolique > request.resource.data.diastolique &&
        texteOk(request.resource.data.auteurNom, 0, 100) &&
        request.resource.data.majAt is int;
      allow delete: if peutFixerObjectif();
    }

    // ════════════════════════════════════════════════════════════════
    //  ESPACE ETABLISSEMENT (B2B2C)
    //  - etablissements/{id} : le createur en est l'administrateur (adminUid,
    //    jamais modifiable). Lecture par les membres.
    //  - membres/{uid} : l'admin a la creation ; un soignant s'ajoute lui-meme
    //    avec le code soignant ; l'admin peut retirer, un soignant peut partir.
    //  - patients/{uid} : le patient s'inscrit lui-meme avec le code patient
    //    (c'est son accord) et peut partir ; l'admin peut le retirer.
    //  - codes_invitation/{code} : lecture d'un code precis seulement (pas de
    //    liste) ; cree et desactive par l'admin.
    //  - affiliations/{uid} : l'etablissement de chaque compte, a lui seul.
    // ════════════════════════════════════════════════════════════════
    match /etablissements/{etabId} {
      allow read: if estMembreEtablissement(etabId);
      allow create: if isSignedIn() && request.resource.data.adminUid == request.auth.uid &&
                       etablissementValide(request.resource.data);
      allow update: if estAdminEtablissement(etabId) &&
                       request.resource.data.adminUid == resource.data.adminUid &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       etablissementValide(request.resource.data);
      allow delete: if false;

      match /membres/{uid} {
        allow read: if estMembreEtablissement(etabId);
        allow create: if isOwner(uid) && request.resource.data.uid == uid &&
          request.resource.data.keys().hasOnly(['uid', 'nom', 'role', 'code', 'joinedAt']) &&
          texteOk(request.resource.data.nom, 0, 100) &&
          request.resource.data.joinedAt is int && (
          (request.resource.data.role == 'ADMIN' &&
           getAfter(/databases/$(database)/documents/etablissements/$(etabId)).data.adminUid == request.auth.uid) ||
          (request.resource.data.role == 'SOIGNANT' &&
           codeValide(request.resource.data.code, etabId, 'SOIGNANT'))
        );
        allow update: if false;
        allow delete: if (isOwner(uid) && resource.data.role != 'ADMIN') ||
                         (estAdminEtablissement(etabId) && uid != request.auth.uid);
      }

      match /patients/{patientUid} {
        allow read: if isOwner(patientUid) || estMembreEtablissement(etabId);
        allow create: if isOwner(patientUid) && request.resource.data.uid == patientUid &&
                         request.resource.data.keys().hasOnly(['uid', 'nom', 'code', 'inscritAt']) &&
                         texteOk(request.resource.data.nom, 0, 100) &&
                         request.resource.data.inscritAt is int &&
                         codeValide(request.resource.data.code, etabId, 'PATIENT');
        allow update: if false;
        allow delete: if isOwner(patientUid) || estAdminEtablissement(etabId);
      }
    }

    match /codes_invitation/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && codeFormat(code) &&
        request.resource.data.keys().hasOnly(['etablissementId', 'etablissementNom', 'type', 'actif', 'createdAt']) &&
        texteOk(request.resource.data.etablissementNom, 2, 80) &&
        request.resource.data.type in ['PATIENT', 'SOIGNANT'] &&
        request.resource.data.actif == true &&
        getAfter(/databases/$(database)/documents/etablissements/$(request.resource.data.etablissementId)).data.adminUid == request.auth.uid;
      // Seule modification permise : desactiver le code
      allow update: if estAdminEtablissement(resource.data.etablissementId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['actif']) &&
                       request.resource.data.actif == false;
      allow delete: if false;
    }

    match /affiliations/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['etablissementId', 'etablissementNom', 'role']) &&
        texteOk(request.resource.data.etablissementId, 1, 40) &&
        texteOk(request.resource.data.etablissementNom, 0, 80) &&
        request.resource.data.role in ['ADMIN', 'SOIGNANT', 'PATIENT'];
    }

    // ════════════════════════════════════════════════════════════════
    //  RAPPORTS PDF
    // ════════════════════════════════════════════════════════════════
    match /reports/{ownerUid} {
      allow read: if isOwner(ownerUid);
      allow write: if isOwner(ownerUid);

      match /items/{reportId} {
        allow read: if isOwner(ownerUid);
        allow create: if isOwner(ownerUid);
        allow update, delete: if isOwner(ownerUid);
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  DEMANDES DE RDV patient -> medecin (v2.1.72)
    //  Collection /rdv_requests/{id} (AppointmentRequestRepository).
    //  Utilisee depuis longtemps par l'app mais JAMAIS declaree ici :
    //  le catch-all la refusait => "PERMISSION_DENIED" a la prise de RDV.
    //  - read   : les 2 parties (les requetes filtrent sur patientUid
    //             ou medecinUid, donc compatible avec les listeners)
    //  - create : le patient, pour lui-meme
    //  - update : le medecin destinataire (accepte/refuse) ou le patient
    //             (annulation)
    // ════════════════════════════════════════════════════════════════
    match /rdv_requests/{requestId} {
      allow read: if isSignedIn() && (
                     resource.data.patientUid == request.auth.uid ||
                     resource.data.medecinUid == request.auth.uid
                   );
      allow create: if isSignedIn() &&
                       request.resource.data.patientUid == request.auth.uid;
      allow update: if isSignedIn() && (
                       resource.data.patientUid == request.auth.uid ||
                       resource.data.medecinUid == request.auth.uid
                     );
      allow delete: if isSignedIn() &&
                       resource.data.patientUid == request.auth.uid;
    }

    // ════════════════════════════════════════════════════════════════
    //  RDV PARTAGES (v2.1.72)
    //  /rdv_shared/{patientUid}/rendezvous/{rdvId}
    //  Ecrit par le MEDECIN quand il accepte une demande, lu par le
    //  patient concerne. Egalement jamais declaree jusqu'ici.
    //  - read  : le patient proprietaire ou son medecin lie
    //  - write : le patient proprietaire, ou le medecin qui se declare
    //            comme auteur du RDV (medecinUid == son uid)
    // ════════════════════════════════════════════════════════════════
    match /rdv_shared/{patientUid} {
      allow read: if isOwner(patientUid) || isLinkedDoctorOf(patientUid);

      match /rendezvous/{rdvId} {
        allow read: if isOwner(patientUid) || isLinkedDoctorOf(patientUid);
        allow create: if isOwner(patientUid) ||
                         (isSignedIn() &&
                          request.resource.data.medecinUid == request.auth.uid);
        allow update: if isOwner(patientUid) ||
                         (isSignedIn() &&
                          resource.data.medecinUid == request.auth.uid);
        allow delete: if isOwner(patientUid) ||
                         (isSignedIn() &&
                          resource.data.medecinUid == request.auth.uid);
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  QUOTA IA (v2.1.72)
    //  L'app utilise la collection `user_quotas` (QuotaRepository), alors
    //  que seule `quota` etait declaree : le compteur journalier etait
    //  donc toujours refuse. Sans consequence visible (QuotaRepository
    //  echoue en mode ouvert) mais le quota n'etait jamais applique.
    // ════════════════════════════════════════════════════════════════
    match /user_quotas/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ════════════════════════════════════════════════════════════════
    //  PAR DEFAUT : tout le reste est refuse
    //  (Si une fonctionnalite a besoin d'acces, l'ajouter explicitement
    //  ci-dessus.)
    // ════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
