rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════════
    //  HELPERS
    // ════════════════════════════════════════════════════════════════
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isResourceOwner() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }
    function isCreatingAsSelf() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    // v2.1.43 : verifie qu'un consent actif existe entre le patient (proprietaire
    // de la donnee) et le medecin authentifie. Doc ID : {patientUid}_{medecinUid}.
    // 1 read supplementaire par requete, accepte pour la securite.
    function isLinkedDoctorOf(patientUid) {
      let docId = patientUid + "_" + request.auth.uid;
      return isSignedIn() &&
             exists(/databases/$(database)/documents/data_sharing/$(docId)) &&
             get(/databases/$(database)/documents/data_sharing/$(docId)).data.isActive == true;
    }
    // v2.1.48 : verifie qu'un lien familial actif existe entre l'owner
    // (proprietaire des donnees) et l'aidant authentifie. Doc ID :
    // {ownerUid}_{aidantUid}. L'aidant peut LIRE les donnees medicales,
    // jamais les modifier.
    function isFamilyAidantOf(ownerUid) {
      let docId = ownerUid + "_" + request.auth.uid;
      return isSignedIn() &&
             exists(/databases/$(database)/documents/family_links/$(docId)) &&
             get(/databases/$(database)/documents/family_links/$(docId)).data.isActive == true;
    }
    // Helper combine : owner OU medecin lie OU aidant familial.
    function canReadPatientData(ownerUid) {
      return isOwner(ownerUid) || isLinkedDoctorOf(ownerUid) || isFamilyAidantOf(ownerUid);
    }

    // ════════════════════════════════════════════════════════════════
    //  PROFILS UTILISATEURS
    //  - lecture : tout authentifie (necessaire pour qu'un patient voie le
    //    profil de son medecin et inversement)
    //  - ecriture : SEULEMENT le proprietaire du compte
    // ════════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId);

      match /repas/{repasId} {
        allow read: if isOwner(userId) || isLinkedDoctorOf(userId);
        allow write: if isOwner(userId);
      }
      match /{subcollection=**} {
        allow read: if isOwner(userId) || isLinkedDoctorOf(userId);
        allow write: if isOwner(userId);
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  DONNEES MEDICALES PATIENT (top-level)
    //  Pattern : chaque doc porte un champ `userId` qui identifie le
    //  proprietaire. Seul lui peut ECRIRE. Lui-meme + son medecin lie
    //  peuvent LIRE.
    // ════════════════════════════════════════════════════════════════
    match /glucose/{docId} {
      allow read: if isResourceOwner() || isLinkedDoctorOf(resource.data.userId) || isFamilyAidantOf(resource.data.userId);
      allow create: if isCreatingAsSelf();
      allow update, delete: if isResourceOwner();
    }
    match /repas/{repasId} {
      allow read: if isResourceOwner() || isLinkedDoctorOf(resource.data.userId) || isFamilyAidantOf(resource.data.userId);
      allow create: if isCreatingAsSelf();
      allow update, delete: if isResourceOwner();
    }
    match /medicaments/{medId} {
      allow read: if isResourceOwner() || isLinkedDoctorOf(resource.data.userId) || isFamilyAidantOf(resource.data.userId);
      allow create: if isCreatingAsSelf();
      allow update, delete: if isResourceOwner();
    }
    match /rendezvous/{rdvId} {
      // RDV peuvent etre crees par le patient OU son medecin lie (le medecin
      // valide un RDV). Mais MODIFICATION seulement par le createur.
      allow read: if isResourceOwner() ||
                     (isSignedIn() && resource.data.medecinUid == request.auth.uid) ||
                     isLinkedDoctorOf(resource.data.userId);
      allow create: if isSignedIn();  // patient ou medecin
      allow update: if isResourceOwner() ||
                       (isSignedIn() && resource.data.medecinUid == request.auth.uid);
      allow delete: if isResourceOwner();
    }
    match /journal/{entryId} {
      allow read: if isResourceOwner() || isLinkedDoctorOf(resource.data.userId) || isFamilyAidantOf(resource.data.userId);
      allow create: if isCreatingAsSelf();
      allow update, delete: if isResourceOwner();
    }
    match /hba1c_lectures/{docId} {
      allow read: if isResourceOwner() || isLinkedDoctorOf(resource.data.userId) || isFamilyAidantOf(resource.data.userId);
      allow create: if isCreatingAsSelf();
      allow update, delete: if isResourceOwner();
    }
    match /patients/{patientId} {
      allow read: if isResourceOwner() || isLinkedDoctorOf(resource.data.userId) || isFamilyAidantOf(resource.data.userId);
      allow create: if isCreatingAsSelf();
      allow update, delete: if isResourceOwner();
    }

    // ════════════════════════════════════════════════════════════════
    //  MESSAGERIE PATIENT-MEDECIN
    //  - Lecture : participants (patient + medecin) listes dans le doc
    //  - Ecriture des messages : un participant seulement
    // ════════════════════════════════════════════════════════════════
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
                     resource.data.patientId == request.auth.uid ||
                     resource.data.medecinId == request.auth.uid
                   );
      allow create: if isSignedIn() && (
                       request.resource.data.patientId == request.auth.uid ||
                       request.resource.data.medecinId == request.auth.uid
                     );
      allow update: if isSignedIn() && (
                       resource.data.patientId == request.auth.uid ||
                       resource.data.medecinId == request.auth.uid
                     );
      allow delete: if false;  // pas de suppression

      match /messages/{messageId} {
        // Pour lire les messages, on doit etre dans la conv parente
        function inConversation() {
          let conv = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
          return isSignedIn() && (conv.patientId == request.auth.uid || conv.medecinId == request.auth.uid);
        }
        allow read: if inConversation();
        allow create: if inConversation() &&
                         request.resource.data.envoyeurId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  HISTORIQUE CHATBOT ROLLY
    //  Chaque sous-collection rolly_history/{userId} appartient a son uid.
    // ════════════════════════════════════════════════════════════════
    match /rolly_history/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  VALIDATIONS ROLLY (medecin valide une recommandation IA)
    // ════════════════════════════════════════════════════════════════
    match /validations/{validationId} {
      allow read: if isSignedIn() && (
                     resource.data.medecinUid == request.auth.uid ||
                     resource.data.patientUid == request.auth.uid
                   );
      allow create: if isSignedIn() &&
                       request.resource.data.medecinUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.medecinUid == request.auth.uid;
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════
    //  CONSENTEMENTS / DATA SHARING
    //  Doc ID : {patientUid}_{medecinUid}
    //  - lecture : les 2 parties impliquees
    //  - creation : par le medecin (demande) ou le patient (auto-link)
    //  - update/delete : par les 2 parties (patient peut revoquer, medecin
    //    peut se desabonner)
    // ════════════════════════════════════════════════════════════════
    match /data_sharing/{docId} {
      function isParty() {
        return isSignedIn() && (
          resource.data.patientUid == request.auth.uid ||
          resource.data.medecinUid == request.auth.uid
        );
      }
      function isPartyOnCreate() {
        return isSignedIn() && (
          request.resource.data.patientUid == request.auth.uid ||
          request.resource.data.medecinUid == request.auth.uid
        );
      }
      allow read: if isParty();
      allow create: if isPartyOnCreate();
      allow update: if isParty();
      allow delete: if isParty();
    }

    // Ancien collection (compat)
    match /consents/{consentId} {
      allow read, write: if isSignedIn();
    }

    // ════════════════════════════════════════════════════════════════
    //  FAMILY LINKS (v2.1.48 — Mode famille)
    //  Doc ID : {ownerUid}_{aidantUid}
    //  - lecture : les 2 parties (owner + aidant)
    //  - create : owner cree l'invitation (ownerUid == auth.uid)
    //  - update : les 2 parties (accept/reject/revoke/reactivate)
    //  - delete : interdit (on garde la tracabilite)
    // ════════════════════════════════════════════════════════════════
    match /family_links/{docId} {
      function isFamilyParty() {
        return isSignedIn() && (
          resource.data.ownerUid == request.auth.uid ||
          resource.data.aidantUid == request.auth.uid
        );
      }
      allow read: if isFamilyParty();
      allow create: if isSignedIn() &&
                       request.resource.data.ownerUid == request.auth.uid;
      allow update: if isFamilyParty();
      allow delete: if false;
    }

    // ════════════════════════════════════════════════════════════════
    //  COMMUNAUTE PATIENTS
    //  Tout user lit. Ecriture : auteur seul.
    // ════════════════════════════════════════════════════════════════
    match /community_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
                               resource.data.userId == request.auth.uid;
    }

    // ════════════════════════════════════════════════════════════════
    //  AVIS PATIENT SUR MEDECIN
    //  Doc ID : {doctorUid}_{patientUid}
    //  - lecture : tout authentifie (les avis sont publics par design)
    //  - creation/maj : par le patient auteur uniquement
    //  - suppression : par le patient auteur ou par le medecin (au cas ou)
    // ════════════════════════════════════════════════════════════════
    match /doctor_reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
                       request.resource.data.patientUid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.patientUid == request.auth.uid;
      allow delete: if isSignedIn() && (
                       resource.data.patientUid == request.auth.uid ||
                       resource.data.doctorUid == request.auth.uid
                     );
    }

    // ════════════════════════════════════════════════════════════════
    //  APPELS VoIP / WebRTC SIGNALING
    // ════════════════════════════════════════════════════════════════
    match /calls/{callId} {
      function isInCall() {
        return isSignedIn() && (
          resource.data.callerUid == request.auth.uid ||
          resource.data.calleeUid == request.auth.uid
        );
      }
      function isInCallOnCreate() {
        return isSignedIn() &&
          request.resource.data.callerUid == request.auth.uid;
      }
      allow read: if isInCall();
      allow create: if isInCallOnCreate();
      allow update: if isInCall();
      allow delete: if isInCall();

      match /{subcollection=**} {
        allow read, write: if isSignedIn();
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  FCM TOKENS (private)
    // ════════════════════════════════════════════════════════════════
    match /fcm_tokens/{tokenId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() &&
                       request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ════════════════════════════════════════════════════════════════
    //  RATE LIMITS (lus + ecrits cote serveur Vercel uniquement,
    //  mais on autorise read par owner pour debug)
    // ════════════════════════════════════════════════════════════════
    match /rate_limits/{docId} {
      allow read: if isSignedIn();
      allow write: if false;  // ecriture serveur uniquement (Admin SDK)
    }

    // ════════════════════════════════════════════════════════════════
    //  QUOTA (IA par jour, par user)
    // ════════════════════════════════════════════════════════════════
    match /quota/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ════════════════════════════════════════════════════════════════
    //  CONFIG APP (mise a jour, versioning) — lecture publique
    // ════════════════════════════════════════════════════════════════
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;  // ecriture manuelle via console firebase
    }

    // ════════════════════════════════════════════════════════════════
    //  BACKUPS PATIENT
    // ════════════════════════════════════════════════════════════════
    //  v2.1.72 : le backup cloud ecrit dans des SOUS-collections
    //  (backups/{uid}/metadata/info, backups/{uid}/glucose/...). Un
    //  `match /backups/{userId}` seul ne couvre PAS les sous-collections :
    //  il faut un `{document=**}` explicite, sinon toute sauvegarde /
    //  restauration est refusee. Le medecin lie lit les donnees patient
    //  depuis backups/{uid}/glucose (cf. DataSharingRepository).
    match /backups/{userId} {
      allow read: if isOwner(userId) || isLinkedDoctorOf(userId);
      allow write: if isOwner(userId) && request.resource.size() < 100000;

      match /{document=**} {
        allow read: if isOwner(userId) || isLinkedDoctorOf(userId);
        allow write: if isOwner(userId);
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  RAPPORTS PDF
    // ════════════════════════════════════════════════════════════════
    match /reports/{ownerUid} {
      allow read: if isOwner(ownerUid);
      allow write: if isOwner(ownerUid);

      match /items/{reportId} {
        allow read: if isOwner(ownerUid);
        allow create: if isOwner(ownerUid);
        allow update, delete: if isOwner(ownerUid);
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  DEMANDES DE RDV patient -> medecin (v2.1.72)
    //  Collection /rdv_requests/{id} (AppointmentRequestRepository).
    //  Utilisee depuis longtemps par l'app mais JAMAIS declaree ici :
    //  le catch-all la refusait => "PERMISSION_DENIED" a la prise de RDV.
    //  - read   : les 2 parties (les requetes filtrent sur patientUid
    //             ou medecinUid, donc compatible avec les listeners)
    //  - create : le patient, pour lui-meme
    //  - update : le medecin destinataire (accepte/refuse) ou le patient
    //             (annulation)
    // ════════════════════════════════════════════════════════════════
    match /rdv_requests/{requestId} {
      allow read: if isSignedIn() && (
                     resource.data.patientUid == request.auth.uid ||
                     resource.data.medecinUid == request.auth.uid
                   );
      allow create: if isSignedIn() &&
                       request.resource.data.patientUid == request.auth.uid;
      allow update: if isSignedIn() && (
                       resource.data.patientUid == request.auth.uid ||
                       resource.data.medecinUid == request.auth.uid
                     );
      allow delete: if isSignedIn() &&
                       resource.data.patientUid == request.auth.uid;
    }

    // ════════════════════════════════════════════════════════════════
    //  RDV PARTAGES (v2.1.72)
    //  /rdv_shared/{patientUid}/rendezvous/{rdvId}
    //  Ecrit par le MEDECIN quand il accepte une demande, lu par le
    //  patient concerne. Egalement jamais declaree jusqu'ici.
    //  - read  : le patient proprietaire ou son medecin lie
    //  - write : le patient proprietaire, ou le medecin qui se declare
    //            comme auteur du RDV (medecinUid == son uid)
    // ════════════════════════════════════════════════════════════════
    match /rdv_shared/{patientUid} {
      allow read: if isOwner(patientUid) || isLinkedDoctorOf(patientUid);

      match /rendezvous/{rdvId} {
        allow read: if isOwner(patientUid) || isLinkedDoctorOf(patientUid);
        allow create: if isOwner(patientUid) ||
                         (isSignedIn() &&
                          request.resource.data.medecinUid == request.auth.uid);
        allow update: if isOwner(patientUid) ||
                         (isSignedIn() &&
                          resource.data.medecinUid == request.auth.uid);
        allow delete: if isOwner(patientUid) ||
                         (isSignedIn() &&
                          resource.data.medecinUid == request.auth.uid);
      }
    }

    // ════════════════════════════════════════════════════════════════
    //  QUOTA IA (v2.1.72)
    //  L'app utilise la collection `user_quotas` (QuotaRepository), alors
    //  que seule `quota` etait declaree : le compteur journalier etait
    //  donc toujours refuse. Sans consequence visible (QuotaRepository
    //  echoue en mode ouvert) mais le quota n'etait jamais applique.
    // ════════════════════════════════════════════════════════════════
    match /user_quotas/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ════════════════════════════════════════════════════════════════
    //  PAR DEFAUT : tout le reste est refuse
    //  (Si une fonctionnalite a besoin d'acces, l'ajouter explicitement
    //  ci-dessus.)
    // ════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
